{
  "rewrites": [
    {
      "source": "/brand",
      "destination": "/brand.html"
    },
    {
      "source": "/hub",
      "destination": "/hub/index.html"
    },
    {
      "source": "/resources",
      "destination": "/resources/index.html"
    },
    {
      "source": "/tools/qr-generator",
      "destination": "/tools/qr-generator/index.html"
    },
    {
      "source": "/resources/tools/:slug",
      "destination": "/api/tool-page?slug=:slug"
    },
    {
      "source": "/og/tools/:slug.png",
      "destination": "/api/og-tool?slug=:slug"
    },
    {
      "source": "/tools/qr-generator/",
      "destination": "/tools/qr-generator/index.html"
    },
    {
      "source": "/tools/fear-greed",
      "destination": "/tools/fear-greed/index.html"
    },
    {
      "source": "/tools/fear-greed/",
      "destination": "/tools/fear-greed/index.html"
    },
    {
      "source": "/code-of-conduct",
      "destination": "/policies/code-of-conduct.html"
    },
    {
      "source": "/programs/stellar-chile/ambassadors",
      "destination": "/policies/ambassadors.html"
    },
    {
      "source": "/en/code-of-conduct",
      "destination": "/policies/en/code-of-conduct.html"
    },
    {
      "source": "/en/programs/stellar-chile/ambassadors",
      "destination": "/policies/en/ambassadors.html"
    }
  ],
  "functions": {
    "api/tool-page.js": {
      "includeFiles": "resources/{tool.html,tools.json}"
    },
    "api/og-tool.js": {
      "includeFiles": "{api/_fonts/*,shared/img/tellus-white.svg,resources/tools.json}"
    }
  }
}
